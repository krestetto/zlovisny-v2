# Discord Webhook URLs — keep these secret, server-side only.
# These are read in app/api/*/route.ts and never exposed to the client
# (do NOT prefix with NEXT_PUBLIC_).

# Форма "Набір в команду" (зелений Embed)
DISCORD_RECRUITMENT_WEBHOOK_URL="https://discord.com/api/webhooks/xxxxx/xxxxx"

# Форма "Підтримка" (червоний Embed / тікети)
DISCORD_SUPPORT_WEBHOOK_URL="https://discord.com/api/webhooks/xxxxx/xxxxx"
